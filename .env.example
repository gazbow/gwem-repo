# Landart Interactive Garden Guide — environment variables
# Copy to .env.local for local dev. Set the real values in Vercel (Project Settings > Environment Variables).
# The app runs end-to-end without any of these set: email + storage degrade gracefully and the
# on-screen result still shows (see Build Spec section 9).

# --- Email (Resend) ---------------------------------------------------------
# Get a key at https://resend.com. Leave unset to disable email in local dev.
RESEND_API_KEY=
# From address must be on a domain verified in Resend, e.g. guide@landart.com.au
EMAIL_FROM="Landart Garden Guide <guide@landart.com.au>"
# Internal notification recipient (new-lead alert). Optional.
LEAD_NOTIFY_EMAIL=studio@landart.com.au

# --- Lead storage -----------------------------------------------------------
# Adapter is chosen by LEAD_STORAGE: "console" (default, logs only), "google-sheets", or "airtable".
LEAD_STORAGE=console

# Google Sheets (Apps Script Web App endpoint that appends a row). Optional.
GOOGLE_SHEETS_WEBHOOK_URL=

# Airtable. Optional.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# --- Analytics --------------------------------------------------------------
# GA4 Measurement ID, e.g. G-XXXXXXXXXX. Align with the Landart site property.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Site -------------------------------------------------------------------
# Public base URL, used for canonical/OG tags and PDF links.
NEXT_PUBLIC_SITE_URL=https://guide.landart.com.au
# Where result links point (the live Landart site).
NEXT_PUBLIC_LANDART_URL=https://landart.com.au
# Where every "Book a consult" action points.
NEXT_PUBLIC_LANDART_CONTACT_URL=https://landart.com.au/contact/
NEXT_PUBLIC_PRIVACY_URL=https://landart.com.au/privacy-policy/
